+namespace {
+	template <size_t Capacity>
+	std::string ReadBoundedGameString(uintptr_t pointer) {
+		if (!pointer) return {};
+		MEMORY_BASIC_INFORMATION memory{};
+		if (!VirtualQuery(reinterpret_cast<const void*>(pointer), &memory, sizeof(memory))
+			|| memory.State != MEM_COMMIT || (memory.Protect & (PAGE_GUARD | PAGE_NOACCESS))) return {};
+		const uintptr_t regionEnd = reinterpret_cast<uintptr_t>(memory.BaseAddress) + memory.RegionSize;
+		if (regionEnd <= pointer) return {};
+		const SIZE_T count = std::min(static_cast<SIZE_T>(Capacity), static_cast<SIZE_T>(regionEnd - pointer));
+		char buffer[Capacity]{};
+		SIZE_T copied = 0;
+		if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(pointer), buffer, count, &copied)
+			|| copied != count) return {};
+		const char* end = static_cast<const char*>(memchr(buffer, '\0', copied));
+		return end ? std::string(buffer, static_cast<size_t>(end - buffer)) : std::string{};
+	}
+}
