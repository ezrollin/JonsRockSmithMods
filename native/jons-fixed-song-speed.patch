+// This separate INI is atomically replaced by the companion app. Poll no more than once a
+// second, and parse only after its timestamp or size changes; never reload every song tick.
+void RiffRepeaterMod::RefreshFixedSpeedConfig(bool force) {
+	const auto now = std::chrono::steady_clock::now();
+	if (!force && now < nextFixedSpeedConfigPoll) return;
+	nextFixedSpeedConfigPoll = now + std::chrono::seconds(1);
+	const std::filesystem::path path("JonsRockSmithMods.ini");
+	std::error_code error;
+	const auto status = std::filesystem::symlink_status(path, error);
+	if (error || !std::filesystem::is_regular_file(status) || std::filesystem::is_symlink(status)) {
+		fixedGlobalSpeedEnabled = false;
+		songSpeedOverrides.clear();
+		fixedSpeedConfigSeen = false;
+		return;
+	}
+	const auto writeTime = std::filesystem::last_write_time(path, error);
+	if (error) return;
+	const auto size = std::filesystem::file_size(path, error);
+	if (error) return;
+	if (!force && fixedSpeedConfigSeen && writeTime == fixedSpeedConfigWriteTime && size == fixedSpeedConfigSize)
+		return;
+	fixedSpeedConfigWriteTime = writeTime;
+	fixedSpeedConfigSize = size;
+	fixedSpeedConfigSeen = true;
+	// Fail closed for malformed/oversized settings, with bounded work and logging.
+	fixedGlobalSpeedEnabled = false;
+	songSpeedOverrides.clear();
+	if (size > 1024 * 1024) {
+		LOG_ERROR("JonsRockSmithMods SPEED_CONFIG_REJECTED file exceeds 1 MB" << std::endl);
+		return;
+	}
+	CSimpleIniA reader;
+	if (reader.LoadFile("JonsRockSmithMods.ini") < 0) {
+		LOG_ERROR("JonsRockSmithMods SPEED_CONFIG_REJECTED file could not be parsed" << std::endl);
+		return;
+	}
+	fixedGlobalSpeedEnabled = CanonicalSongKey(reader.GetValue("Toggle Switches", "JonsFixedSongSpeedEnabled", "off")) == "on";
+	fixedGlobalSpeedPercent = ParseFixedSpeedPercent(reader.GetValue("Mod Settings", "JonsFixedSongSpeedPercent", "85"));
+	if (!fixedGlobalSpeedPercent) fixedGlobalSpeedPercent = 85;
+	CSimpleIniA::TNamesDepend keys;
+	reader.GetAllKeys("Song Speed Overrides", keys);
+	if (keys.size() > 4096) {
+		fixedGlobalSpeedEnabled = false;
+		LOG_ERROR("JonsRockSmithMods SPEED_CONFIG_REJECTED more than 4096 song overrides" << std::endl);
+		return;
+	}
+	for (const auto& key : keys) {
+		const std::string songKey(key.pItem);
+		if (songKey.empty() || songKey.size() > 128
+			|| songKey.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-") != std::string::npos)
+			continue;
+		const int percent = ParseFixedSpeedPercent(reader.GetValue("Song Speed Overrides", key.pItem, ""));
+		if (percent) songSpeedOverrides[CanonicalSongKey(songKey)] = percent;
+	}
+	LOG_INFO("JonsRockSmithMods SPEED_CONFIG_RELOADED global=" << (fixedGlobalSpeedEnabled ? "on" : "off")
+		<< " percent=" << fixedGlobalSpeedPercent << " songOverrides=" << songSpeedOverrides.size() << std::endl);
+}
+
+int RiffRepeaterMod::RequestedFixedSpeedPercent() const {
+	if (activeFixedSpeedIdentityConfirmed && !activeFixedSpeedSongKey.empty()) {
+		const auto found = songSpeedOverrides.find(CanonicalSongKey(activeFixedSpeedSongKey));
+		if (found != songSpeedOverrides.end()) return found->second;
+	}
+	return fixedGlobalSpeedEnabled ? fixedGlobalSpeedPercent : 0;
+}
