+	bool WriteSongRemovalRequest(const std::string& songKey) {
+        // SongKey is also used as a filename: accept only the bridge's safe ASCII alphabet.
+        if (songKey.empty() || songKey.size() > 128 ||
+            !std::all_of(songKey.begin(), songKey.end(), [](unsigned char value) {
+                return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z')
+                    || (value >= '0' && value <= '9') || value == '_' || value == '.' || value == '-';
+            })) {
+			return RejectSongRemovalRequest("F10 not saved: the selected song ID is invalid.");
+        }
+		DWORD required = GetEnvironmentVariableW(L"LOCALAPPDATA", nullptr, 0);
+		if (required == 0 || required > 32768) {
+			return RejectSongRemovalRequest("F10 not saved: Windows could not find the local request folder.");
+		}
+		std::wstring localAppData(required, L'\0');
+		DWORD copied = GetEnvironmentVariableW(L"LOCALAPPDATA", localAppData.data(), required);
+		if (copied == 0 || copied >= required) {
+			return RejectSongRemovalRequest("F10 not saved: Windows could not read the local request folder.");
+		}
+		localAppData.resize(copied);
+
+		std::error_code directoryError;
+		const auto directory = std::filesystem::path(localAppData) / L"JonsRockSmithMods" / L"InGameSongRequests";
+		std::filesystem::create_directories(directory, directoryError);
+		if (directoryError) {
+			return RejectSongRemovalRequest("F10 not saved: could not create the local mark folder.");
+		}
+
+        // Marks remain until acknowledged. Repeated presses share one case-insensitive identity.
+        std::string canonicalSongKey = songKey;
+        for (char& value : canonicalSongKey) {
+            if (value >= 'A' && value <= 'Z') value = static_cast<char>(value + ('a' - 'A'));
+        }
+        const std::string requestId = "song-" + canonicalSongKey;
+        const std::wstring wideRequestId(requestId.begin(), requestId.end());
+        const auto requestPath = directory / (L"request-" + wideRequestId + L".json");
+		const bool alreadyMarked = std::filesystem::exists(requestPath, directoryError);
+		if (directoryError) {
+			return RejectSongRemovalRequest("F10 not saved: could not check whether this song is already marked.");
+		}
+		if (alreadyMarked) {
+			LOG_INFO("[JonsRockSmithMods] Song already marked for later review: " << songKey << std::endl);
+			GameOverlay::SetSongRemovalStatus("F10 received earlier: this song is already marked for Do Not Want after Rocksmith closes.");
+			return true;
+        }
+        size_t requestCount = 0;
+        for (std::filesystem::directory_iterator entry(directory, directoryError), end;
+            !directoryError && entry != end; entry.increment(directoryError)) {
+            const auto name = entry->path().filename().wstring();
+            if (name.rfind(L"request-", 0) == 0 && entry->path().extension() == L".json") {
+                if (++requestCount >= 64) break;
+            }
+        }
+        if (directoryError || requestCount >= 64) {
+			return RejectSongRemovalRequest("F10 not saved: saved marks are full or unreadable. Review them in JonsRockSmithMods.");
+        }
+
+		const auto sequence = g_songRemovalRequestSequence.fetch_add(1, std::memory_order_relaxed);
+		const auto capturedAt = std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::system_clock::now().time_since_epoch()).count();
+        const std::wstring temporaryId = std::to_wstring(GetCurrentProcessId()) + L"-"
+            + std::to_wstring(GetTickCount64()) + L"-" + std::to_wstring(sequence);
+		const auto temporaryPath = directory / (L".pending-" + temporaryId + L".tmp");
+		const std::string json = "{\"version\":1,\"request_id\":\"" + requestId
+			+ "\",\"song_key\":\"" + songKey + "\",\"captured_at_unix_ms\":"
+			+ std::to_string(capturedAt) + "}";
+
+		HANDLE file = CreateFileW(temporaryPath.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW,
+			FILE_ATTRIBUTE_NORMAL, nullptr);
+		if (file == INVALID_HANDLE_VALUE) {
+			return RejectSongRemovalRequest("F10 not saved: could not create the mark file. Check folder permissions.");
+		}
+		DWORD written = 0;
+		const bool wroteAll = WriteFile(file, json.data(), static_cast<DWORD>(json.size()), &written, nullptr)
+			&& written == static_cast<DWORD>(json.size()) && FlushFileBuffers(file);
+		CloseHandle(file);
+		if (!wroteAll || !MoveFileExW(temporaryPath.c_str(), requestPath.c_str(), MOVEFILE_WRITE_THROUGH)) {
+			DeleteFileW(temporaryPath.c_str());
+			return RejectSongRemovalRequest("F10 not saved: Windows could not finish writing the mark file.");
+		}
+		LOG_INFO("[JonsRockSmithMods] Song marked for later reversible removal review: " << songKey << std::endl);
+		GameOverlay::SetSongRemovalStatus("F10 RECEIVED: " + songKey + " marked for removal.\nAfter close, the app moves a verified single-song file to Do Not Want.\nPacks must be split first; undo in JonsRockSmithMods.");
+		return true;
+	}
